---
import DefaultLayout from './DefaultLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { CATEGORIES } from '@config/site';
import type { CategoryKey } from '@config/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  category: CategoryKey;
  articles: CollectionEntry<'articles'>[];
  title?: string;
  description?: string;
}
const { category, articles, title, description } = Astro.props;
const cat = CATEGORIES[category];
---
<DefaultLayout title={title} description={description}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10">
      <p class="text-sm text-brand-600 dark:text-brand-500 font-medium mb-2">
        {Object.values(CATEGORIES).find((c) => c.label === cat.label)?.label ?? cat.label}
      </p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight">{cat.label}</h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400 max-w-2xl">{cat.description}</p>
    </header>

    {articles.length === 0 ? (
      <p class="text-neutral-500 py-12 text-center">暂无内容，敬请期待。</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {articles.map((a) => <ArticleCard article={a} />)}
      </div>
    )}
  </section>
</DefaultLayout>