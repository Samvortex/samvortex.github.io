---
import { SITE, CATEGORIES } from '@config/site';
import type { CategoryKey } from '@config/site';

const { CATEGORIES: _c } = { CATEGORIES };
const path = Astro.url.pathname;
function active(href: string) {
  if (href === '/') return path === '/' ? 'text-brand-600 dark:text-brand-500' : '';
  return path.startsWith(href) ? 'text-brand-600 dark:text-brand-500' : '';
}
---
<header class="border-b border-neutral-200 dark:border-neutral-800 sticky top-0 backdrop-blur bg-white/80 dark:bg-neutral-950/80 z-40">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-semibold tracking-tight text-lg">
      <span class="text-brand-600 dark:text-brand-500">Samvortex</span>
      <span class="text-neutral-500 dark:text-neutral-400 text-sm ml-1">Hub</span>
    </a>
    <nav class="hidden md:flex items-center gap-5 text-sm">
      <a href="/" class={`hover:text-brand-600 ${active('/')}`}>首页</a>
      {(Object.entries(CATEGORIES) as [CategoryKey, typeof CATEGORIES[CategoryKey]][])
        .sort(([, a], [, b]) => a.order - b.order)
        .map(([key, cat]) => (
          <a href={`/${key}/`} class={`hover:text-brand-600 ${active(`/${key}`)}`}>
            {cat.label}
          </a>
        ))}
      <a href="/about/" class={`hover:text-brand-600 ${active('/about')}`}>关于</a>
    </nav>
    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        aria-label="切换主题"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
      </button>
      <a href="/search/" class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100" aria-label="搜索">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
      </a>
      <a href={SITE.github} target="_blank" rel="noopener" class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  });
</script>