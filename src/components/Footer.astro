---
import { SITE } from '@config/site';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-neutral-200 dark:border-neutral-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 text-sm text-neutral-500 dark:text-neutral-400 flex flex-col sm:flex-row gap-2 justify-between">
    <div>
      © {year} {SITE.author}. 保留所有权利。
    </div>
    <div class="flex gap-4">
      <a href="/rss.xml" class="hover:text-brand-600">RSS</a>
      <a href={SITE.repo} class="hover:text-brand-600" target="_blank" rel="noopener">源码</a>
      <a href="/about/" class="hover:text-brand-600">关于</a>
    </div>
  </div>
</footer>