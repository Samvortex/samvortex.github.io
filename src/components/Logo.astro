---
/**
 * Logo.astro — Samvortex brand mark + animated variants
 *
 * Usage:
 *   <Logo size={24} variant="header" />            // header use
 *   <Logo size={128} variant="hero" />              // hero / 404 / loading page
 *   <Logo size={32} variant="static" />             // favicon-like static
 *   <Logo size={48} variant="header" theme="dark" />// explicit dark variant
 *
 * Props:
 *   size:    number  — px size (default 32)
 *   variant: 'header' | 'hero' | 'static' | 'icon-only'
 *   theme:   'auto' | 'light' | 'dark'
 *   label:   boolean — show "Samvortex Hub" wordmark next to mark
 */
export interface Props {
  size?: number;
  variant?: 'header' | 'hero' | 'static' | 'icon-only';
  theme?: 'auto' | 'light' | 'dark';
  label?: boolean;
}
const { size = 32, variant = 'header', theme = 'auto', label = false } = Astro.props;

// Animation tier based on variant:
//   static  → no animation (favicon, OG)
//   header  → 60s ambient rotation + hover speedup
//   hero    → full intro animation + ambient rotation + hover
const animClass = {
  static: 'sv-static',
  header: 'sv-header',
  hero:   'sv-hero',
  'icon-only': 'sv-static',
}[variant];
---

<a href="/" class={`sv-logo sv-logo--${variant} sv-logo--${theme} ${animClass}`}
   aria-label="Samvortex Hub" style={`--sv-size:${size}px`}>
  <span class="sv-mark" aria-hidden="true">
    <svg viewBox="0 0 64 64" width={size} height={size}>
      <defs>
        <linearGradient id={`sv-g-${variant}`} x1="6" y1="10" x2="58" y2="54" gradientUnits="userSpaceOnUse">
          <stop offset="0"   stop-color="#2563eb"/>
          <stop offset=".55" stop-color="#0891b2"/>
          <stop offset="1"   stop-color="#7c3aed"/>
        </linearGradient>
        <radialGradient id={`sv-d-${variant}`} cx="50%" cy="42%" r="55%">
          <stop offset="0"   stop-color="#000" stop-opacity="0.22"/>
          <stop offset="0.65" stop-color="#000" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="14" fill={`url(#sv-g-${variant})`}/>
      <rect x="2" y="2" width="60" height="60" rx="14" fill={`url(#sv-d-${variant})`}/>
      <g fill="#F0EDE3">
        <path d="M48.78 25.10 C50.50 27.99 50.86 30.86 49.55 33.69 C48.10 36.83 45.43 38.79 41.66 39.71 C37.79 40.65 33.94 40.16 30.86 38.18 C29.49 37.31 28.46 36.20 27.71 34.90 C26.85 33.40 26.45 31.79 27.19 30.16 C27.96 28.46 29.43 27.49 31.27 27.13 C33.71 26.65 36.10 26.99 38.27 28.13 C39.71 28.90 40.71 30.04 40.96 31.66 C41.13 32.79 40.78 33.74 40.00 34.51"/>
        <path d="M37.96 49.71 C35.07 51.43 32.20 51.79 29.37 50.48 C26.23 49.03 24.27 46.36 23.35 42.59 C22.41 38.72 22.90 34.87 24.88 31.79 C25.75 30.42 26.86 29.39 28.16 28.64 C29.66 27.78 31.27 27.38 32.90 28.12 C34.60 28.89 35.57 30.36 35.93 32.20 C36.41 34.64 36.07 37.03 34.93 39.20 C34.16 40.64 33.02 41.64 31.40 41.89 C30.27 42.06 29.32 41.71 28.55 40.93"/>
        <path d="M13.35 38.89 C11.63 36.00 11.27 33.13 12.58 30.30 C14.03 27.16 16.70 25.20 20.47 24.28 C24.34 23.34 28.19 23.83 31.27 25.81 C32.64 26.68 33.67 27.79 34.42 29.09 C35.28 30.59 35.68 32.20 34.94 33.83 C34.17 35.53 32.70 36.50 30.86 36.86 C28.42 37.34 26.03 37.00 23.86 35.86 C22.42 35.09 21.42 33.95 21.17 32.33 C21.00 31.20 21.35 30.25 22.13 29.48"/>
      </g>
      <circle cx="32" cy="32" r="2.4" fill="#F0EDE3"/>
    </svg>
  </span>
  {label && (
    <span class="sv-wordmark">
      <span class="sv-name">Samvortex</span><span class="sv-hub">Hub</span>
    </span>
  )}
</a>

<style>
  .sv-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    line-height: 1;
  }

  .sv-mark {
    display: inline-block;
    width: var(--sv-size);
    height: var(--sv-size);
    flex-shrink: 0;
    /* Optical alignment: text x-height center sits below the geometric center.
       For header text at 18px, shift mark down 2px. */
    transform: translateY(2px);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sv-wordmark {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.125em;  /* matches header's text-lg */
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sv-name {
    color: var(--sv-fg, #0a0a0a);
  }
  :global(.dark) .sv-name {
    color: #fafafa;
  }
  .sv-hub {
    color: var(--sv-muted, #737373);
    font-weight: 400;
    margin-left: 0.375em;
    font-size: 0.78em;
  }
  :global(.dark) .sv-hub {
    color: #a3a3a3;
  }

  /* ── Animation tiers ─────────────────────────────────────── */

  /* static: no animation, no hover effects */
  .sv-static .sv-mark {
    animation: none !important;
  }

  /* header: slow ambient rotation, hover speedup */
  .sv-header .sv-mark svg {
    animation: sv-rotate 60s linear infinite;
    transform-origin: 50% 50%;
  }
  .sv-header:hover .sv-mark svg {
    animation-duration: 4s;
  }

  /* hero: intro draw + ambient rotation */
  .sv-hero .sv-mark {
    animation: sv-intro 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .sv-hero .sv-mark svg {
    animation: sv-rotate 60s linear 1.4s infinite;
    transform-origin: 50% 50%;
  }
  .sv-hero:hover .sv-mark svg {
    animation-duration: 4s;
  }

  @keyframes sv-rotate {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes sv-intro {
    0%   { opacity: 0; transform: translateY(2px) scale(0.6) rotate(-30deg); filter: blur(8px); }
    60%  { filter: blur(0); }
    100% { opacity: 1; transform: translateY(2px) scale(1) rotate(0deg); filter: blur(0); }
  }

  /* accessibility: honor system reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .sv-header .sv-mark svg,
    .sv-hero .sv-mark svg,
    .sv-hero .sv-mark {
      animation: none !important;
    }
  }
</style>
