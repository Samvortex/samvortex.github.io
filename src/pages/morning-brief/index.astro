---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import { getCollection } from 'astro:content';

const briefs = await getCollection('morningBrief');
briefs.sort((a, b) => b.data.date.localeCompare(a.data.date));

// 首屏只展示最近 30 期
const recent = briefs.slice(0, 30);
---
<DefaultLayout
  title="每日早报"
  description="Sam's OpenClaw Agent 自动生成的每日 10 领域新闻简报。每日 7:00 AM Asia/Shanghai 发布。"
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-20">
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-3 text-xs uppercase tracking-wider text-brand-600 dark:text-brand-500 font-semibold">
        <span>每日早报 · Morning Brief</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
        全球 10 大领域，<span class="text-brand-600 dark:text-brand-500">每天 7 点</span>送到
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
        报刊杂志样式 · 真实新闻链接 · 数据视图 · AI/科技/经济/政治/气候/时事/旅游/娱乐/音乐/教育
      </p>
      <p class="text-sm text-neutral-500 dark:text-neutral-500 mt-3">
        由 Sam's OpenClaw Agent 自动生成 · 共 {briefs.length} 期
      </p>
    </div>

    {recent.length === 0 ? (
      <div class="rounded-lg border border-dashed border-neutral-300 dark:border-neutral-700 p-8 text-center text-neutral-500">
        暂无早报。每日 7:00 AM Asia/Shanghai 自动发布第一期。
      </div>
    ) : (
      <div class="space-y-3">
        {recent.map((brief) => {
          const lead = brief.data.lead;
          const sectionCount = brief.data.sections.length;
          const chartCount = brief.data.sections.filter((s) => s.chart).length;
          return (
            <a
              href={`/morning-brief/${brief.id}/`}
              class="group block rounded-lg border border-neutral-200 dark:border-neutral-800 p-5 hover:border-brand-500 dark:hover:border-brand-500 transition-colors"
            >
              <div class="flex items-baseline gap-4">
                <div class="font-mono text-sm text-brand-600 dark:text-brand-500 font-semibold shrink-0 w-28">
                  {brief.data.date}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-semibold mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-500 transition-colors">
                    {lead.headline}
                  </h3>
                  <div class="flex items-center gap-3 text-xs text-neutral-500">
                      <span>{sectionCount} 个板块</span>
                      <span>·</span>
                      <span>{chartCount} 个数据视图</span>
                      <span>·</span>
                      <span class="truncate">来源：{lead.source}</span>
                    </div>
                </div>
                <div class="text-brand-600 dark:text-brand-500 text-2xl shrink-0 group-hover:translate-x-1 transition-transform">
                  →
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </section>
</DefaultLayout>