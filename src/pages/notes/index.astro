---
import ListLayout from '@layouts/ListLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === 'notes'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<ListLayout category="notes" articles={articles} title="杂谈" description="短记录与思考碎片。" />